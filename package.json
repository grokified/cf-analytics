{
  "name": "cf-analytics",
  "version": "1.0.0",
  "private": true,
  "description": "Vercel-style analytics dashboard for Cloudflare Web Analytics. Self-host on Cloudflare Workers and sign in with an API token.",
  "license": "MIT",
  "author": "Faisal Ashfaq",
  "homepage": "https://github.com/imfaisii009/cf-analytics#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imfaisii009/cf-analytics.git"
  },
  "bugs": {
    "url": "https://github.com/imfaisii009/cf-analytics/issues"
  },
  "keywords": [
    "cloudflare",
    "cloudflare-workers",
    "cloudflare-web-analytics",
    "web-analytics",
    "analytics-dashboard",
    "vercel-analytics",
    "privacy-friendly-analytics",
    "google-analytics-alternative",
    "self-hosted",
    "graphql-analytics",
    "react",
    "shadcn-ui",
    "tailwindcss",
    "recharts"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "lint": "oxlint",
    "cf-typegen": "wrangler types"
  },
  "cloudflare": {
    "bindings": {
      "SESSION_SECRET": {
        "description": "Random string that encrypts the session cookie. Generate one with `openssl rand -hex 32`."
      }
    }
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "workerd": true,
    "esbuild": true
  }
}
